{
  "id": "remotehand.notes",
  "name": "RemoteHand Notes",
  "version": "0.1.3",
  "apiVersion": 1,
  "author": "RemoteHand",
  "description": "Private Vault-backed sticky notes and checklists for RemoteHand.",
  "runtime": {
    "kind": "executable",
    "entrypoints": {
      "windows-x86_64": "bin/windows-x86_64/remotehand-notes.exe",
      "linux-x86_64": "bin/linux-x86_64/remotehand-notes",
      "linux-aarch64": "bin/linux-aarch64/remotehand-notes"
    }
  },
  "permissions": [
    "vault.documents.read",
    "vault.documents.write",
    "vault.blobs.read",
    "vault.blobs.write",
    "vault.access.request",
    "storage.plugin",
    "files.open"
  ],
  "contributes": {
    "sidebar": [
      {
        "id": "notes",
        "title": "Notes",
        "icon": "assets/sidebar.svg",
        "panel": "notes"
      }
    ],
    "panels": [
      {
        "id": "notes",
        "title": "Notes",
        "entry": "ui/index.html"
      }
    ],
    "commands": [
      {
        "id": "open",
        "title": "Open Notes"
      }
    ]
  }
}
